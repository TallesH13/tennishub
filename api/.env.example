# Copie para .env e preencha. O .env nunca vai para o Git.
# As duas strings vêm do painel do Neon: Dashboard > Connect, na SUA branch.

# Conexão usada pela API: com "Connection pooling" LIGADO (host termina em "-pooler").
DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Conexão direta, usada pelas migrations e pelo seed: "Connection pooling" DESLIGADO (sem "-pooler").
# Obrigatória quando a DATABASE_URL usa o pooler.
DATABASE_URL_DIRECT=postgresql://neondb_owner:SENHA@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Plano B sem internet (PostgreSQL local): troque as duas linhas acima por
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tennishub
# DATABASE_URL_DIRECT=

# Segredo para assinar a sessão do proprietário (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Proprietário criado pelo seed (npm run seed). Não há tela de cadastro (D09).
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Opcionais
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
