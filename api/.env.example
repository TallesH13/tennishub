# Copie para .env e preencha. O .env nunca vai para o Git.

# Conexão usada pela aplicação. No Neon, use a string do pooler (host com "-pooler").
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# Conexão direta, usada só pelas migrations (no Neon, a string sem "-pooler").
# Se ficar vazia, as migrations usam a DATABASE_URL.
DATABASE_URL_DIRECT=

# Segredo para assinar a sessão do proprietário (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Proprietário criado pelo seed (npm run seed). Não há tela de cadastro (D09).
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Opcionais
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
